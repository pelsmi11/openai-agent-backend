DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Vercel AI Gateway (chat + embeddings) — replaces the old OPENAI_API_KEY.
# Swap AI_GATEWAY_CHAT_MODEL / AI_GATEWAY_EMBEDDING_MODEL to change providers/models,
# no code changes needed. AI_GATEWAY_BASE_URL only needs to be set if the endpoint changes.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_CHAT_MODEL=openai/gpt-4o-mini
AI_GATEWAY_EMBEDDING_MODEL=openai/text-embedding-3-small

# Resend (meeting confirmation emails) — free tier includes 1 verified custom domain
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google Calendar (service account with access to Hector's calendar)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Static Meet room: meet.google.com -> "Nueva reunión" -> "Crear una reunión para más tarde".
# The link doesn't expire from reuse (only recycled after 365 days with zero use).
GOOGLE_MEET_URL=

# ZITADEL API application (Console -> project -> Applications -> New -> API, auth method
# Private Key JWT). Protects this backend's own routes via token introspection.
# ZITADEL_API_CLIENT_ID / ZITADEL_API_KEY_ID / ZITADEL_API_PRIVATE_KEY come from the
# downloaded key JSON (clientId, keyId, key — keep the \n escapes in the key when pasting).
ZITADEL_DOMAIN=https://persona-instance-kmhdkb.us1.zitadel.cloud
ZITADEL_API_CLIENT_ID=
ZITADEL_API_KEY_ID=
ZITADEL_API_PRIVATE_KEY=
